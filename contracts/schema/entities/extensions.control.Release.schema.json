    "extensions.control.Release.State": {
      "title": "State",
      "x-ess-name": "extensions.control.Release.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Recorded"
      ]
    },
    "extensions.control.ReleaseId": {
      "title": "ReleaseId",
      "x-ess-name": "extensions.control.ReleaseId",
      "x-ess-kind": "newtype",
      "type": "string"
