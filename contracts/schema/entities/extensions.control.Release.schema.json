        "configuration": {
          "type": "boolean"
        }
      },
      "required": [
        "version_updates",
        "enable_disable",
        "removal",
        "configuration"
      ],
      "additionalProperties": false
    },
    "extensions.control.InstallationPolicy": {
      "title": "InstallationPolicy",
      "x-ess-name": "extensions.control.InstallationPolicy",
      "x-ess-kind": "struct",
      "type": "object",
